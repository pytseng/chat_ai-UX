ANTHROPIC_API_KEY=your_key_here

# Open-Meteo needs no API key for non-commercial use (https://open-meteo.com)

# Portfolio / demo recording: plain chat, no web search, weather tools, or subject guardrails
RECORDING_MODE=false

# Recommended for accurate product images (Google Images via SerpAPI).
# Without this key, the app falls back to DuckDuckGo + Wikimedia (less accurate).
# Get a free key at https://serpapi.com/ (100 searches/month on free tier).
SERPAPI_KEY=your_key_here
